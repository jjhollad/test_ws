      Show Axes: true
      Show Names: true
      Tree:
        {}
      Update Interval: 0
      Value: false
  Enabled: true
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: map
    Frame Rate: 8
  Name: root
  Tools:
